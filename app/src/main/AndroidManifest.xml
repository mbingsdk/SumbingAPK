<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        BUG FIX Android 16 — configChanges di Activity
        Tanpa ini, setiap rotation/resize menyebabkan MainActivity restart
        → MediaProjection permission dialog muncul lagi
        → Service menerima intent baru tanpa projection_data → overlay tidak muncul
    -->
    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher_sumbing"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_sumbing"
        android:supportsRtl="true"
        android:theme="@style/Theme.SumbingCompanion">

        <activity
            android:name="com.sdkdev.sumbingcompanion.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SumbingCompanion"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RegionCalibrationActivity"
            android:theme="@style/Theme.Transparent"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <service
            android:name="com.sdkdev.sumbingcompanion.ui.overlay.FloatingWindowService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>